STUDIO_ENV=development
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8080
# Cloud Run injects PORT; do not define it in local configuration.
STUDIO_DATA_DIRECTORY=.studio-data
STUDIO_ENABLE_VERTEX=false
STUDIO_ENABLE_MODEL_QUESTIONS=false
STUDIO_ENABLE_MODEL_BRIEFING=false
STUDIO_ENABLE_MODEL_SPECIFICATION=false
STUDIO_ENABLE_MODEL_REVISION=false
STUDIO_ADK_ROOT_NAME=studio_root_agent
STUDIO_ADK_APP_NAME=agents
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
STUDIO_PERSISTENCE=local
STUDIO_ENABLE_FIRESTORE=false
STUDIO_FIRESTORE_DATABASE=collaborative-taskmaster
STUDIO_FIRESTORE_LOCATION=us-central1
STUDIO_FIRESTORE_TRANSACTION_MAX_ATTEMPTS=5
STUDIO_FIRESTORE_DEMO_RETENTION_DAYS=7
GOOGLE_GENAI_USE_VERTEXAI=false
STUDIO_GEMINI_MODEL=gemini-3.7-flash
STUDIO_VERTEX_API_VERSION=v1
STUDIO_MAX_MODEL_OUTPUT_TOKENS=8192
STUDIO_MAX_MODEL_QUESTIONS_PER_PROJECT=3
STUDIO_GENERATED_ROOT=generated
STUDIO_PROJECTS_ROOT=projects
# Durable project replication for Cloud Run. The bucket must already exist.
STUDIO_ENABLE_CLOUD_STORAGE=false
STUDIO_ENABLE_CLOUD_TASKS=false
STUDIO_CLOUD_TASKS_LOCATION=us-central1
STUDIO_CLOUD_TASKS_QUEUE=taskmaster-builds
STUDIO_BUILD_WORKER_SERVICE_ACCOUNT=
# Dedicated private Cloud Run worker. If empty, local/single-service mode uses STUDIO_PUBLIC_BASE_URL.
STUDIO_BUILD_WORKER_URL=
STUDIO_BUILD_WORKER_AUDIENCE=
# Declares the runtime that will execute externally dispatched builds.
STUDIO_EXTERNAL_BUILDER_RUNTIME=
STUDIO_PROJECTS_BUCKET=
STUDIO_PROJECTS_BUCKET_PREFIX=taskmaster-projects
STUDIO_PROJECTS_MAX_FILES=500
STUDIO_PROJECTS_MAX_TOTAL_BYTES=50000000
# controlled_adk is the safe default. Use antigravity only after installing the optional SDK.
STUDIO_AGENT_BUILDER=controlled_adk
# Absolute path to a separate Python environment containing google-antigravity.
STUDIO_ANTIGRAVITY_PYTHON=
STUDIO_ANTIGRAVITY_VERTEX_LOCATION=us-central1
# Explicitly pin the Vertex model used by the Antigravity runtime.
STUDIO_ANTIGRAVITY_MODEL=gemini-2.5-flash
# Multi-user identity. Keep local only for development; Cloud Run must use identity_platform.
STUDIO_AUTH_MODE=local
STUDIO_IDENTITY_PROJECT=collaborative-taskmaster-dev
STUDIO_FIREBASE_API_KEY=
STUDIO_FIREBASE_AUTH_DOMAIN=
STUDIO_FIREBASE_APP_ID=

# Public OAuth entry points. Values secretos se inyectan desde Secret Manager; nunca se confirman.
STUDIO_PUBLIC_BASE_URL=http://127.0.0.1:8080
STUDIO_GOOGLE_OAUTH_CLIENT_ID=
STUDIO_GOOGLE_OAUTH_CLIENT_SECRET=
STUDIO_GITHUB_OAUTH_CLIENT_ID=
STUDIO_GITHUB_OAUTH_CLIENT_SECRET=
STUDIO_OAUTH_STATE_SECRET=
# Base64 URL-safe de exactamente 32 bytes.
STUDIO_OAUTH_ENCRYPTION_KEY=
