# Vertex AI configuration. Copy to .env locally; never commit the real file.
GOOGLE_CLOUD_PROJECT=sentinel-taskmaster-dev
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
SENTINEL_GEMINI_MODEL=gemini-2.5-flash
SENTINEL_ENABLE_VERTEX_PLANNER=false

# Hard controls for the planner's live model call.
SENTINEL_MAX_OUTPUT_TOKENS=350
SENTINEL_MAX_PLAN_STEPS=3
